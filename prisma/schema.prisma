generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum DataStatus { LIVE DELAYED STALE UNAVAILABLE DEMO }
enum OrderSide { BUY SELL }
enum OrderStatus { PENDING FILLED CANCELLED REJECTED }
model User { id String @id @default(cuid()) email String @unique passwordHash String createdAt DateTime @default(now()) watchlist Watchlist[] orders PaperOrder[] positions PaperPosition[] alerts Alert[] strategies Strategy[] settings AppSettings? }
model Stock { id String @id @default(cuid()) symbol String @unique tradingSymbol String companyName String exchange String @default("NSE") sector String? industry String? active Boolean @default(true) quotes MarketQuote[] candles HistoricalCandle[] watchlists Watchlist[] @@index([companyName]) @@index([sector,active]) }
model MarketQuote { id BigInt @id @default(autoincrement()) stockId String stock Stock @relation(fields:[stockId],references:[id]) price Decimal @db.Decimal(18,4) previousClose Decimal @db.Decimal(18,4) change Decimal @db.Decimal(18,4) changePercent Decimal @db.Decimal(9,4) open Decimal? high Decimal? low Decimal? volume BigInt? averageVolume BigInt? marketCap Decimal? week52High Decimal? week52Low Decimal? timestamp DateTime source String dataStatus DataStatus @@index([stockId,timestamp(sort: Desc)]) @@index([changePercent]) }
model HistoricalCandle { id BigInt @id @default(autoincrement()) stockId String stock Stock @relation(fields:[stockId],references:[id]) interval String timestamp DateTime open Decimal high Decimal low Decimal close Decimal volume BigInt? source String dataStatus DataStatus @@unique([stockId,interval,timestamp]) }
model Watchlist { id String @id @default(cuid()) userId String stockId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) stock Stock @relation(fields:[stockId],references:[id]) priceAlert Decimal? percentAlert Decimal? createdAt DateTime @default(now()) @@unique([userId,stockId]) }
model PaperOrder { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id]) symbol String side OrderSide quantity Int orderType String limitPrice Decimal? fillPrice Decimal? stopLoss Decimal? target Decimal? status OrderStatus @default(PENDING) createdAt DateTime @default(now()) filledAt DateTime? @@index([userId,status,createdAt]) }
model PaperPosition { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id]) symbol String quantity Int averagePrice Decimal side OrderSide stopLoss Decimal? target Decimal? openedAt DateTime @default(now()) closedAt DateTime? realizedPnl Decimal @default(0) @@index([userId,closedAt]) }
model PaperTrade { id String @id @default(cuid()) positionId String symbol String side OrderSide quantity Int entryPrice Decimal exitPrice Decimal? realizedPnl Decimal? openedAt DateTime closedAt DateTime? @@index([symbol,openedAt]) }
model Alert { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id]) symbol String? type String threshold Decimal? enabled Boolean @default(true) lastTriggeredAt DateTime? createdAt DateTime @default(now()) @@index([userId,enabled]) }
model Strategy { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id]) name String enabled Boolean @default(false) config Json runs StrategyRun[] createdAt DateTime @default(now()) }
model StrategyRun { id String @id @default(cuid()) strategyId String strategy Strategy @relation(fields:[strategyId],references:[id]) startedAt DateTime @default(now()) completedAt DateTime? signalsGenerated Int @default(0) metadata Json? @@index([strategyId,startedAt(sort: Desc)]) }
model AppSettings { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id]) startingBalance Decimal @default(1000000) defaultStopLoss Decimal @default(2) defaultTarget Decimal @default(4) momentumThreshold Int @default(75) breakoutSettings Json relativeVolumeThreshold Decimal @default(1.5) refreshInterval Int @default(15) theme String @default("dark") }
