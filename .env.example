NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://trademate:change-me@db:5432/trademate
REDIS_URL=redis://redis:6379
DATA_PROVIDER=
MARKET_DATA_API_KEY=
# Required on Vercel so Dhan Connect cookies can be encrypted.
SESSION_SECRET=replace-with-at-least-32-random-characters
BROKER_READ_ONLY=true
# Optional server-wide DhanHQ read-only credentials (Vercel env). Never prefix with VITE_.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Same paper book on every device. Example: TM-NARESH
PAPER_BOOK_ID=
# Optional durable store (Vercel KV / Upstash). Without this, books live in server memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
